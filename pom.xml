                <shade.native.exclude.5>com/sun/jna/win32-x86-64/**</shade.native.exclude.5>
                <shade.native.exclude.6>com/sun/jna/linux-*/**</shade.native.exclude.6>
                <shade.native.exclude.17>com/sun/jna/darwin-*/**</shade.native.exclude.17>
