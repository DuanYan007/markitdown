    <groupId>com.markitdown</groupId>
    <artifactId>markitdown-java</artifactId>
    <version>0.0.3</version>
    <packaging>jar</packaging>

    <name>MarkItDown Java</name>
    <description>Java implementation of Microsoft MarkItDown - A powerful document to Markdown converter</description>
    <url>https://github.com/yourusername/markitdown-java</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>http://www.opensource.org/licenses/mit-license.php</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>duan yan</name>
            <email>2907762730@qq.com</email>
            <organization>Open Source Community</organization>
            <organizationUrl>https://github.com/DuanYan007</organizationUrl>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/DuanYan007/markitdown-java.git</connection>
        <developerConnection>scm:git:ssh://github.com:DuanYan007/markitdown-java.git</developerConnection>
        <url>https://github.com/DuanYan007/markitdown-java/tree/main</url>
