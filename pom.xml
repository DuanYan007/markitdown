        <profile>
            <id>mac</id>
            <properties>
                <build.profile>mac</build.profile>
                <shade.native.exclude.1>win32-x86/**</shade.native.exclude.1>
                <shade.native.exclude.2>win32-x86-64/**</shade.native.exclude.2>
                <shade.native.exclude.3>com/sun/jna/win32-aarch64/**</shade.native.exclude.3>
